{
  "name": "onfinity-integration-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev:control-plane": "pnpm --filter @ip/control-plane dev",
    "validate:connectors": "pnpm --filter @ip/connector-factory validate ../../connectors",
    "controlplane:up": "docker compose -f docker/docker-compose.controlplane.yml up -d",
    "controlplane:down": "docker compose -f docker/docker-compose.controlplane.yml down"
  }
}
