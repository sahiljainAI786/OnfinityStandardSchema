{
  "entity": "CurrencyRate",
  "table": "C_Conversion_Rate",
  "pk": "C_Conversion_Rate_ID",
  "key": { "api": "validFrom", "column": "ValidFrom", "label": "Valid From date" },
  "identifierColumns": ["ValidFrom"],
  "keyScope": ["fromCurrency", "toCurrency", "conversionType"],
  "includeStandardCols": true,

  "_note": "Currency conversion rate = C_Conversion_Rate. It has no single business key - a rate is identified by (fromCurrency, toCurrency, conversionType, validFrom). So the key is validFrom, scoped by the currency pair + type (keyScope). Provide multiplyRate; the model derives divideRate (and vice-versa). Mostly insert-only.",

  "fields": [
    { "api": "validFrom", "column": "ValidFrom", "type": "string", "required": true, "isKey": true, "help": "ISO date (NN)" },
    { "api": "validTo",   "column": "ValidTo",   "type": "string", "help": "ISO date" },

    { "api": "fromCurrency", "column": "C_Currency_ID", "type": "ref", "required": true,
      "ref": { "table": "C_Currency", "matchOn": "ISO_Code", "returns": "C_Currency_ID" },
      "help": "source currency (ISO code)" },
    { "api": "toCurrency", "column": "C_Currency_To_ID", "type": "ref", "required": true,
      "ref": { "table": "C_Currency", "matchOn": "ISO_Code", "returns": "C_Currency_ID" },
      "help": "target currency (ISO code)" },
    { "api": "conversionType", "column": "C_ConversionType_ID", "type": "ref", "required": true,
      "ref": { "table": "C_ConversionType", "matchOn": "Name", "returns": "C_ConversionType_ID" },
      "help": "rate type, e.g. 'Spot'" },

    { "api": "multiplyRate", "column": "MultiplyRate", "type": "number", "required": true,
      "help": "source * rate = target" },
    { "api": "divideRate",   "column": "DivideRate",   "type": "number", "help": "auto-derived from multiplyRate if omitted" },
    { "api": "isActive",     "column": "IsActive",     "type": "boolean", "default": true }
  ]
}
