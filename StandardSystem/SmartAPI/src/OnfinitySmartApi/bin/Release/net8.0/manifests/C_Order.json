{
  "entity": "SalesQuotation",
  "table": "C_Order",
  "pk": "C_Order_ID",
  "key": { "api": "key", "column": "DocumentNo", "label": "External reference (Document No)" },
  "identifierColumns": ["DocumentNo"],
  "includeStandardCols": true,

  "_note": "TRANSACTIONAL DOCUMENT - a sales quotation = C_Order (quotation C_DocType) + C_OrderLine lines. INSERT-ONLY: DocumentNo is auto-generated by the doctype sequence (the model reassigns it), so the 'key' you pass is nominal and existence-by-key won't match - every call inserts; put your real external reference in poReference. The header's AD_Org_ID and C_BPartner_Location_ID are DERIVED from the businessPartner (org must match the partner/warehouse org, else the model rejects the header). The MOrder partner-copy callouts do NOT fire on raw insert, so priceList/currency/warehouse/paymentTerm/paymentRule are required explicitly. Each line derives its UOM from the product and its org from the warehouse; the model computes QtyOrdered + tax; price defaults to 0 unless you pass it (or the product is priced in the list). The created order is a DRAFT - completing it (DocAction) needs a VAAPI RunProcess, not yet wired.",

  "fields": [
    { "api": "key",     "column": "DocumentNo", "type": "string", "required": true, "isKey": true, "maxLen": 30,
      "help": "nominal; the model assigns the real DocumentNo. Use poReference for your external ref." },
    { "api": "isSOTrx", "column": "IsSOTrx", "type": "boolean", "default": true },

    { "api": "businessPartner", "column": "C_BPartner_ID", "type": "ref", "required": true,
      "ref": { "table": "C_BPartner", "matchOn": "Value", "returns": "C_BPartner_ID" } },
    { "api": "docType", "column": "C_DocTypeTarget_ID", "type": "ref", "required": true,
      "ref": { "table": "C_DocType", "matchOn": "Name", "returns": "C_DocType_ID" },
      "help": "quotation doc type, e.g. 'Sales Quotation' / 'Sales Proposal'" },

    { "api": "dateOrdered",  "column": "DateOrdered",  "type": "string", "required": true, "help": "ISO date" },
    { "api": "datePromised", "column": "DatePromised", "type": "string", "help": "ISO date" },
    { "api": "description",  "column": "Description",  "type": "string", "maxLen": 255 },
    { "api": "poReference",  "column": "POReference",  "type": "string", "maxLen": 20, "help": "your external reference" },

    { "api": "priceList", "column": "M_PriceList_ID", "type": "ref", "required": true,
      "ref": { "table": "M_PriceList", "matchOn": "Name", "returns": "M_PriceList_ID" } },
    { "api": "currency", "column": "C_Currency_ID", "type": "ref", "required": true,
      "ref": { "table": "C_Currency", "matchOn": "ISO_Code", "returns": "C_Currency_ID" } },
    { "api": "warehouse", "column": "M_Warehouse_ID", "type": "ref", "required": true,
      "ref": { "table": "M_Warehouse", "matchOn": "Value", "returns": "M_Warehouse_ID" },
      "help": "must be in the partner's organisation" },
    { "api": "paymentTerm", "column": "C_PaymentTerm_ID", "type": "ref", "required": true,
      "ref": { "table": "C_PaymentTerm", "matchOn": "Value", "returns": "C_PaymentTerm_ID" } },
    { "api": "paymentRule", "column": "PaymentRule", "type": "string", "default": "P", "help": "P=On Credit (NN)" },

    { "api": "_org", "column": "AD_Org_ID", "type": "derived",
      "derived": { "from": "businessPartner", "table": "C_BPartner",
                   "whereColumn": "C_BPartner_ID", "selectColumn": "AD_Org_ID" } },
    { "api": "_location", "column": "C_BPartner_Location_ID", "type": "derived",
      "derived": { "from": "businessPartner", "table": "C_BPartner_Location",
                   "whereColumn": "C_BPartner_ID", "selectColumn": "C_BPartner_Location_ID",
                   "extraWhere": "IsBillTo='Y'" } }
  ],

  "children": {
    "lines": {
      "table": "C_OrderLine",
      "pk": "C_OrderLine_ID",
      "parentLink": "C_Order_ID",
      "fields": [
        { "api": "product", "column": "M_Product_ID", "type": "ref", "required": true,
          "ref": { "table": "M_Product", "matchOn": "Value", "returns": "M_Product_ID" } },
        { "api": "warehouse", "column": "M_Warehouse_ID", "type": "ref", "required": true,
          "ref": { "table": "M_Warehouse", "matchOn": "Value", "returns": "M_Warehouse_ID" } },
        { "api": "qty", "column": "QtyEntered", "type": "number", "required": true },
        { "api": "price", "column": "PriceEntered", "type": "number",
          "alsoColumns": ["PriceActual", "PriceList"],
          "help": "unit price. When provided it is USED (mirrored to PriceEntered/PriceActual/PriceList, overriding the price list). Omit it to let the price list drive the price." },
        { "api": "description", "column": "Description", "type": "string", "maxLen": 255 },

        { "api": "_uom", "column": "C_UOM_ID", "type": "derived",
          "derived": { "from": "product", "table": "M_Product",
                       "whereColumn": "M_Product_ID", "selectColumn": "C_UOM_ID" } },
        { "api": "_org", "column": "AD_Org_ID", "type": "derived",
          "derived": { "from": "warehouse", "table": "M_Warehouse",
                       "whereColumn": "M_Warehouse_ID", "selectColumn": "AD_Org_ID" } }
      ]
    }
  },

  "actions": {
    "complete": { "searchKey": "C_Order Process", "label": "Complete the document",
      "params": [ { "name": "DocAction", "const": "CO",
        "help": "CO=Complete. NOTE: the Process Order job reads the order's DocAction column; completing may require setting DocAction first (verify live)." } ] },
    "convertToOrder": { "searchKey": "Quatation Quote convert", "label": "Convert quotation to a Sales Order" }
  }
}
