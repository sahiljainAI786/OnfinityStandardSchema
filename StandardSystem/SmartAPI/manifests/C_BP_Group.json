{
  "entity": "BPGroup",
  "table": "C_BP_Group",
  "pk": "C_BP_Group_ID",
  "key": { "api": "key", "column": "Value", "label": "Search Key" },
  "identifierColumns": ["Value", "Name"],
  "includeStandardCols": true,

  "_note": "Business-partner group / category = C_BP_Group (keyed by Value; what BusinessPartner 'group' resolves). Provides defaults (price list, etc.) for its partners.",

  "fields": [
    { "api": "key",       "column": "Value", "type": "string",  "required": true, "isKey": true, "maxLen": 40 },
    { "api": "name",      "column": "Name",  "type": "string",  "required": true, "maxLen": 60 },
    { "api": "isDefault", "column": "IsDefault", "type": "boolean", "default": false },
    { "api": "isConfidentialInfo", "column": "IsConfidentialInfo", "type": "boolean", "default": false },
    { "api": "isActive",  "column": "IsActive", "type": "boolean", "default": true },

    { "api": "priceList", "column": "M_PriceList_ID", "type": "ref",
      "ref": { "table": "M_PriceList", "matchOn": "Name", "returns": "M_PriceList_ID" } }
  ]
}
