{
  "entity": "Qualification",
  "table": "VA058_Qualification",
  "pk": "VA058_Qualification_ID",
  "key": { "api": "key", "column": "Name", "label": "Qualification Name" },
  "includeStandardCols": true,
  "_note": "HR qualification (VA058). categoryName and country are NN/required.",
  "fields": [
    { "api": "key", "column": "Name", "type": "string", "required": true, "isKey": true, "maxLen": 50 },
    { "api": "categoryName", "column": "CategoryName", "type": "list", "required": true,
      "list": { "Bachelor": "B", "Doctoral Degree": "D", "Honors Degree": "H", "Master": "M", "Phd": "P" } },
    { "api": "country", "column": "C_Country_ID", "type": "ref", "required": true,
      "ref": { "table": "C_Country", "matchOn": "CountryCode", "returns": "C_Country_ID" } },
    { "api": "isActive", "column": "IsActive", "type": "boolean", "default": true }
  ]
}
