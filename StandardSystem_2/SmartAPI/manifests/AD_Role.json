    { "api": "isAccessAllOrgs",  "column": "IsAccessAllOrgs",   "type": "boolean", "default": false },
    { "api": "isAdministrator",  "column": "IsAdministrator",   "type": "boolean", "default": false },
    { "api": "isCanExport",      "column": "IsCanExport",       "type": "boolean", "default": true },
    { "api": "isCanReport",      "column": "IsCanReport",       "type": "boolean", "default": true },
    { "api": "isCanApproveOwnDoc","column": "IsCanApproveOwnDoc","type": "boolean", "default": true },
    { "api": "confirmQueryRecords","column": "ConfirmQueryRecords","type": "number", "default": 0 },
