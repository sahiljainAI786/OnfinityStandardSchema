# Per-client parameters. The control plane GENERATES one of these per client at
# clients/<CLIENT_ID>.env (secrets are random per client). This file documents the shape.
# Never commit a real client env — it holds secrets (see ../.gitignore).

CLIENT_ID=acme
CLIENT_DOMAIN=acme.platform.example.com

# our rebranded Activepieces CE image
BRAND_IMAGE=registry.example.com/yourbrand/automation:1.0.0

# unique host port assigned by the control plane (reverse proxy maps the domain to it)
APP_PORT=8201

# per-client secrets — generated by the control plane, distinct per client
AP_JWT_SECRET=replace-with-generated-secret
AP_ENCRYPTION_KEY=replace-with-generated-32-byte-hex

# per-client database credentials
POSTGRES_DB=activepieces
POSTGRES_USER=ap_acme
POSTGRES_PASSWORD=replace-with-generated-secret
